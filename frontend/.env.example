# Public URL of the website (used for SEO: canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL of the Node backend (../backend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# WhatsApp Business number, digits only with country code (e.g. 66812345678). Leave empty to hide WhatsApp buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public inquiry email shown in the footer
NEXT_PUBLIC_CONTACT_EMAIL=
