# Port the API listens on
PORT=4000

# The website's origin(s), comma-separated. Requests from anywhere else are refused (CORS).
FRONTEND_ORIGIN=http://localhost:3000

# Where leads are stored (one JSON object per line). Created automatically.
DATA_DIR=./data

# Token for reading leads: GET /api/leads with header "Authorization: Bearer <token>".
# Leave empty to disable the endpoint.
ADMIN_TOKEN=

# Optional email alert for every new lead. Leave SMTP_HOST empty to only log to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mahanakorn Website <no-reply@example.com>"
MAIL_TO=

# Express "trust proxy" setting, needed for correct rate limiting behind a proxy (e.g. 1 on Render/Heroku/Nginx).
TRUST_PROXY=0
